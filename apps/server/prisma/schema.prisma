generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USUÁRIOS E AUTENTICAÇÃO
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  isVerified        Boolean   @default(false)
  isSuspended       Boolean   @default(false)
  isAdmin           Boolean   @default(false)
  // Emblema BETA NEXT: quem criou conta enquanto o Nexus estava em beta
  // (o dono fecha a entrada de novos no painel e pode dar/tirar na mão)
  isBetaTester      Boolean   @default(false)
  // Cargo Staff (equipe do Nexus): ganha as molduras e o ícone da equipe. O dono dá/tira no painel.
  // isAdmin também conta como Staff.
  isStaff           Boolean   @default(false)
  // Versão do app de PC (Electron) da última vez que a pessoa entrou por ele —
  // o dono vê no painel quem já atualizou. Vazio = nunca usou o app de PC.
  desktopVersion    String?   @db.VarChar(20)
  desktopSeenAt     DateTime?
  // Verificação em duas etapas (TOTP). O segredo fica cifrado; os códigos de
  // recuperação ficam só como hash (cada um vale uma vez).
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  twoFactorRecovery String[]  @default([])
  // Plano: "gratis", "mais" (Nexus+) ou "pro" (Nexus Pro). Pago vale até
  // planoAte; depois volta sozinho para "gratis" (PlanosService).
  plano             String    @default("gratis") @db.VarChar(10)
  planoAte          DateTime?
  // Afiliados: link nexuslink.art/r/<codigoIndicacao>. Quem indicou ganha
  // dias de Nexus+ quando a pessoa indicada ganha o primeiro plano pago.
  codigoIndicacao   String?   @unique @db.VarChar(12)
  indicadoPorId     String?
  indicacaoPaga     Boolean   @default(false)
  diasGanhos        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile                Profile?
  emailVerifications     EmailVerification[]
  dmReactions            DirectMessageReaction[]
  notificationMutes      NotificationMute[]
  sessions               Session[]
  memberships            ServerMember[]
  messages               Message[]
  reactions              Reaction[]
  sentInvites            Invite[]                @relation("InviteCreator")
  blockedBy              Block[]                 @relation("BlockedUser")
  blocking               Block[]                 @relation("BlockingUser")
  reportsCreated         Report[]                @relation("Reporter")
  reportsReceived        Report[]                @relation("ReportedUser")
  auditLogs              AuditLog[]              @relation("AuditActor")
  callParticipants       CallParticipant[]
  passwordResets         PasswordReset[]
  attachments            Attachment[]
  directMessagesSent     DirectMessage[]         @relation("DMSender")
  directMessagesReceived DirectMessage[]         @relation("DMReceiver")
  friendRequestsSent     Friendship[]            @relation("FriendRequester")
  friendRequestsReceived Friendship[]            @relation("FriendAddressee")
  pushSubscriptions      PushSubscription[]
  announcementReads      AnnouncementRead[]
  callStats              CallStat[]
  conquistas             Conquista[]
  depoimento             Depoimento?
  ideiaVotos             IdeiaVoto[]
  carteira               Carteira?
  nexMovimentos          NexMovimento[]
  prismaMovimentos       PrismaMovimento[]
  pedidosPix             PedidoPix[]
  // Versão dos Termos/Privacidade que a pessoa aceitou (com a declaração de ter 18+)
  termosVersao           String?                 @db.VarChar(10)
  termosAceitosEm        DateTime?
  missaoResgates         MissaoResgate[]
  itens                  ItemPosse[]
  zoeiras                ZoeiraEstoque[]
  indicadoPor            User?                   @relation("Indicacoes", fields: [indicadoPorId], references: [id], onDelete: SetNull)
  indicados              User[]                  @relation("Indicacoes")

  @@index([email])
  @@index([username])
  @@index([indicadoPorId])
  @@map("users")
}

// ── Amizades ────────────────────────────────────────────────────
// PENDING = pedido enviado aguardando resposta · ACCEPTED = amigos
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

model Profile {
  id             String     @id @default(cuid())
  userId         String     @unique
  displayName    String
  avatarUrl      String?
  bannerUrl      String?
  bannerColor    String? // gradiente hex "de,para" usado quando não há imagem de banner
  bio            String?    @db.VarChar(300)
  status         UserStatus @default(ONLINE)
  customStatus   String?    @db.VarChar(128)
  // Itens da loja Nex equipados (ids do catálogo em src/loja/loja.catalogo.ts)
  moldura        String?    @db.VarChar(40)
  icone          String?    @db.VarChar(40)
  placa          String?    @db.VarChar(40)
  somEntrada     String?    @db.VarChar(40)
  efeitoPerfil   String?    @db.VarChar(40)
  // Zoeiras na call: aceita receber? escudo ativo até quando?
  receberZoeiras Boolean    @default(true)
  escudoAte      DateTime?
  // Perfil gamer (editor em Configurações → Perfil)
  corNome        String?    @db.VarChar(32) // Nexus+/Pro: "#hex" ou degradê "#hex,#hex"
  jogos          Json? // até 6: [{ jogo, rank?, nick? }]
  conexoes       Json? // { steam?, twitch?, youtube?, instagram?, tiktok?, riot?, xbox?, psn? }
  procurandoDuo  Boolean    @default(false)
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum UserStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVIDORES E CANAIS
// ─────────────────────────────────────────────────────────────────────────────

model Server {
  id             String   @id @default(cuid())
  name           String
  description    String?  @db.VarChar(500)
  tag            String?  @db.VarChar(32)
  iconUrl        String?
  bannerUrl      String?
  isPublic       Boolean  @default(false)
  maxMembers     Int      @default(100)
  // Zoeiras pesadas (calar, ensurdecer, apelido) só se o dono ligar
  zoeirasPesadas Boolean  @default(false)
  // Tema da loja Nex que veste o servidor inteiro (id do catálogo)
  tema           String?  @db.VarChar(40)
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members    ServerMember[]
  channels   Channel[]
  voiceRooms VoiceRoom[]
  invites    Invite[]
  reports    Report[]       @relation("ServerReports")
  auditLogs  AuditLog[]
  roles      Role[]
  emojis     CustomEmoji[]
  callStats  CallStat[]

  @@index([ownerId])
  @@map("servers")
}

// ── Cargos personalizados (estilo Discord) ──────────────────────
// isDefault = cargo @everyone: permissões base de todos os membros.
// permissions = JSON array de chaves (ver PERMISSIONS no código).
model Role {
  id          String   @id @default(cuid())
  serverId    String
  name        String   @db.VarChar(64)
  color       String   @default("#99aab5") @db.VarChar(16)
  hoist       Boolean  @default(false) // exibir membros separadamente
  mentionable Boolean  @default(false) // qualquer um pode @mencionar
  permissions String   @default("[]") @db.VarChar(4000)
  position    Int      @default(0) // maior = mais alto na hierarquia
  isDefault   Boolean  @default(false) // cargo @everyone (não deletável)
  createdAt   DateTime @default(now())

  server      Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  assignments RoleAssignment[]
  voiceRooms  VoiceRoom[]      @relation("VoiceRoomAllowedRoles")

  @@index([serverId])
  @@map("roles")
}

// ── Emojis customizados do servidor (máx. 50) ───────────────────
model CustomEmoji {
  id        String   @id @default(cuid())
  serverId  String
  name      String   @db.VarChar(32) // usado como :nome: no chat
  url       String   @db.Text
  creatorId String
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
  @@map("custom_emojis")
}

// ── Modelo de servidor (snapshot de canais/cargos/config) ───────
model ServerTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  serverId    String
  title       String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  snapshot    String   @db.Text // JSON: canais, salas, cargos, config
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([serverId])
  @@map("server_templates")
}

model RoleAssignment {
  roleId   String
  memberId String

  role   Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  member ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([roleId, memberId])
  @@index([memberId])
  @@map("role_assignments")
}

model ServerMember {
  id           String     @id @default(cuid())
  serverId     String
  userId       String
  role         MemberRole @default(MEMBER)
  nickname     String?    @db.VarChar(64)
  joinedAt     DateTime   @default(now())
  mutedBy      Boolean    @default(false) // silenciado por admin (global na sala)
  banned       Boolean    @default(false)
  bannedAt     DateTime?
  bannedReason String?

  server          Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAssignments RoleAssignment[]

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@map("server_members")
}

enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

model Channel {
  id              String      @id @default(cuid())
  serverId        String
  name            String      @db.VarChar(64)
  description     String?     @db.VarChar(256)
  type            ChannelType @default(TEXT)
  position        Int         @default(0)
  isPrivate       Boolean     @default(false)
  slowModeSeconds Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([serverId])
  @@map("channels")
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
}

model VoiceRoom {
  id          String   @id @default(cuid())
  serverId    String
  name        String   @db.VarChar(64)
  position    Int      @default(0)
  maxUsers    Int      @default(25)
  bitrate     Int      @default(64000) // bps
  livekitRoom String   @unique // nome da room no LiveKit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server       Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  callSessions CallSession[]
  // Sala restrita: só quem tem um destes cargos (ou dono/admin) vê e entra.
  // Lista vazia = sala aberta a todos os membros.
  allowedRoles Role[]        @relation("VoiceRoomAllowedRoles")

  @@index([serverId])
  @@map("voice_rooms")
}

// ─────────────────────────────────────────────────────────────────────────────
// MENSAGENS
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id         String    @id @default(cuid())
  channelId  String
  authorId   String
  content    String    @db.VarChar(4000)
  replyToId  String?
  edited     Boolean   @default(false)
  editedAt   DateTime?
  deleted    Boolean   @default(false)
  deletedAt  DateTime?
  // Mensagem fixada no canal (permissão "Fixar mensagens")
  pinned     Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedById String?
  // @everyone/@todos ("everyone") ou @here/@aqui ("here"), só quando o cargo
  // do autor tem "Mencionar todos"; sem isso o texto fica, mas não avisa ninguém
  mentionAll String?   @db.VarChar(10)
  createdAt  DateTime  @default(now())

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyTo     Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[]    @relation("MessageReplies")
  reactions   Reaction[]
  attachments Attachment[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([channelId, pinned])
  @@map("messages")
}

model DirectMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String    @db.VarChar(4000)
  read       Boolean   @default(false)
  readAt     DateTime?
  edited     Boolean   @default(false)
  editedAt   DateTime?
  deleted    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  sender      User                      @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                      @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  attachments DirectMessageAttachment[]
  reactions   DirectMessageReaction[]

  @@index([senderId, receiverId, createdAt(sort: Desc)])
  @@map("direct_messages")
}

// Reações (emoji) em mensagens diretas
model DirectMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(64)
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("direct_message_reactions")
}

// Link de confirmação de e-mail (vale 24h, uso único)
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

// Silenciar um servidor inteiro ou um canal: sem som/aviso/notificação no celular
// (o contador de não lidas continua). Exatamente um dos dois alvos é preenchido.
model NotificationMute {
  id        String   @id @default(cuid())
  userId    String
  serverId  String?
  channelId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@unique([userId, channelId])
  @@index([userId])
  @@map("notification_mutes")
}

model DirectMessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("direct_message_attachments")
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("reactions")
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String
  uploaderId String
  url        String
  fileName   String
  fileSize   Int // bytes
  mimeType   String
  width      Int? // para imagens
  height     Int?
  createdAt  DateTime @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@index([messageId])
  @@map("attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONVITES
// ─────────────────────────────────────────────────────────────────────────────

model Invite {
  id          String    @id @default(cuid())
  serverId    String
  creatorId   String
  code        String    @unique
  maxUses     Int? // null = ilimitado
  uses        Int       @default(0)
  expiresAt   DateTime?
  guestAccess Boolean   @default(false) // permite entrar sem conta
  createdAt   DateTime  @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation("InviteCreator", fields: [creatorId], references: [id])

  @@index([code])
  @@index([serverId])
  @@map("invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAMADAS DE VOZ/VÍDEO
// ─────────────────────────────────────────────────────────────────────────────

model CallSession {
  id          String    @id @default(cuid())
  voiceRoomId String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  voiceRoom    VoiceRoom         @relation(fields: [voiceRoomId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([voiceRoomId])
  @@map("call_sessions")
}

model CallParticipant {
  id              String    @id @default(cuid())
  callSessionId   String
  userId          String
  livekitIdentity String // identidade no LiveKit
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  micEnabled      Boolean   @default(true)
  camEnabled      Boolean   @default(false)
  screenSharing   Boolean   @default(false)

  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([callSessionId])
  @@index([userId])
  @@map("call_participants")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODERAÇÃO E SEGURANÇA
// ─────────────────────────────────────────────────────────────────────────────

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id              String       @id @default(cuid())
  reporterId      String
  targetUserId    String?
  targetMessageId String?
  targetServerId  String?
  reason          ReportReason
  description     String?      @db.VarChar(1000)
  status          ReportStatus @default(PENDING)
  resolvedById    String?
  resolvedAt      DateTime?
  resolution      String?      @db.VarChar(500)
  createdAt       DateTime     @default(now())

  reporter     User    @relation("Reporter", fields: [reporterId], references: [id])
  targetUser   User?   @relation("ReportedUser", fields: [targetUserId], references: [id])
  targetServer Server? @relation("ServerReports", fields: [targetServerId], references: [id])

  @@index([status])
  @@index([reporterId])
  @@map("reports")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  EXPLICIT_CONTENT
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDITORIA
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  serverId   String?
  actorId    String
  action     String // ex: "MEMBER_KICK", "CHANNEL_CREATE", "MESSAGE_DELETE"
  targetType String? // "USER" | "CHANNEL" | "MESSAGE" | ...
  targetId   String?
  meta       Json? // dados extras (reason, before/after state)
  createdAt  DateTime @default(now())

  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  actor  User    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([serverId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

// ── Notificações no celular (Web Push) ──────────────────────────
// Cada navegador/aparelho que ativou as notificações vira uma inscrição.
// O endpoint é único: se outra conta entrar no mesmo aparelho, a inscrição
// passa para ela.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Configurações internas do app (ex.: chaves VAPID do Web Push, geradas no
// primeiro uso e guardadas aqui para não depender de variável de ambiente).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ── Comunicados da plataforma ───────────────────────────────────
// Avisos do dono do Nexus para todos os usuários. Cada pessoa vê o
// comunicado em destaque até clicar em "Entendi" (vira um AnnouncementRead).
// O autor fica só como id: apagar a conta dele não apaga os comunicados.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  createdAt DateTime @default(now())

  reads AnnouncementRead[]

  @@index([createdAt(sort: Desc)])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ─────────────────────────────────────────────────────────────────────────────
// PLACAR DA CALL E CONQUISTAS
// ─────────────────────────────────────────────────────────────────────────────

// Placar por servidor ("Quem mora na call?"). O site manda um batimento por
// minuto enquanto a pessoa está na call; o servidor só soma o tempo que passou
// de verdade desde o batimento anterior (não dá para inflar mandando mais).
model CallStat {
  id              String    @id @default(cuid())
  serverId        String
  userId          String
  segundosCall    Int       @default(0)
  segundosFalando Int       @default(0)
  segundosCamera  Int       @default(0)
  musicas         Int       @default(0) // pedidas ao DJ ou tocadas pela janela de música
  lives           Int       @default(0) // transmissões de tela começadas
  ultimoBatimento DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
  @@map("call_stats")
}

// Conquista desbloqueada (chave fixa no código, ex.: "mora-na-call")
model Conquista {
  id             String   @id @default(cuid())
  userId         String
  chave          String   @db.VarChar(32)
  desbloqueadaEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chave])
  @@map("conquistas")
}

// Comentário de quem usa o Nexus para a página inicial. Só aparece depois
// que o dono aprova; editar volta para a fila de aprovação.
model Depoimento {
  id           String   @id @default(cuid())
  userId       String   @unique
  texto        String   @db.VarChar(280)
  nota         Int      @default(5)
  aprovado     Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([aprovado, atualizadoEm])
  @@map("depoimentos")
}

// ── Economia Nex ────────────────────────────────────────────────
// Moeda ganha jogando (presença diária, roleta, missões) e gasta na loja.
// Nunca é vendida por dinheiro. Datas de "hoje" em horário de Brasília (AAAA-MM-DD).
model Carteira {
  userId         String   @id
  saldo          Int      @default(0)
  totalGanho     Int      @default(0)
  presencaDia    Int      @default(0) // último dia pego no ciclo de 7
  presencaData   String?  @db.VarChar(10)
  presencaMelhor Int      @default(0) // maior sequência já feita
  roletaData     String?  @db.VarChar(10)
  roletaGiros    Int      @default(0)
  unidosVitorias Int      @default(0)
  unidosData     String?  @db.VarChar(10)
  unidosHoje     Int      @default(0)
  // Prisma: moeda AZUL comprada com dinheiro (src/loja/loja.prisma.ts). Nunca vira Nex.
  prismas        Int      @default(0)
  atualizadoEm   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carteiras")
}

// Extrato: toda entrada e saída de Nex, com o motivo
model NexMovimento {
  id       String   @id @default(cuid())
  userId   String
  valor    Int
  motivo   String   @db.VarChar(48)
  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, criadoEm])
  @@map("nex_movimentos")
}

// Extrato da Prisma (moeda paga): toda entrada e saída, com o motivo
model PrismaMovimento {
  id       String   @id @default(cuid())
  userId   String
  valor    Int
  motivo   String   @db.VarChar(48)
  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, criadoEm])
  @@map("prisma_movimentos")
}

// Missão já resgatada: periodo = "sempre" ou o dia (AAAA-MM-DD) das diárias
model MissaoResgate {
  userId   String
  missao   String   @db.VarChar(40)
  periodo  String   @db.VarChar(10)
  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, missao, periodo])
  @@map("missao_resgates")
}

// Itens que a pessoa tem (comprou na loja, ganhou em baú, evento ou presente).
// expiraEm: itens temporários (ex.: moldura de 7 dias da roleta).
model ItemPosse {
  userId   String
  itemId   String    @db.VarChar(40)
  origem   String    @db.VarChar(16)
  expiraEm DateTime?
  criadoEm DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("itens_posse")
}

// Zoeiras guardadas para usar na call (cada uso gasta 1)
model ZoeiraEstoque {
  userId String
  zoeira String @db.VarChar(32)
  qtd    Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, zoeira])
  @@map("zoeiras_estoque")
}

// Página "Em breve": cada pessoa vota uma vez em cada ideia (quero / não preciso).
// A lista de ideias fica no código (src/ideias/ideias.lista.ts).
model IdeiaVoto {
  ideia    String   @db.VarChar(40)
  userId   String
  tipo     String   @db.VarChar(8)
  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideia, userId])
  @@index([userId])
  @@map("ideia_votos")
}

// Pedido pago por Pix (Efí): plano, pacote de Prisma ou doação.
// ambiente separa produção de homologação (a cópia de teste usa homologação no mesmo banco).
model PedidoPix {
  id            String    @id @default(cuid())
  userId        String
  txid          String    @unique @db.VarChar(35)
  ambiente      String    @db.VarChar(12) // producao | homologacao
  tipo          String    @db.VarChar(10) // plano | prisma | doacao
  item          String    @db.VarChar(24) // mais-mes, pro-ano, pp-100, doacao
  valorCentavos Int
  status        String    @default("pendente") @db.VarChar(10) // pendente | pago | expirado
  copiaECola    String
  qrImagem      String?   // data URL do QR Code que o Efí devolve (alguns KB)
  expiraEm      DateTime
  pagoEm        DateTime?
  e2eId         String?   @db.VarChar(40)
  criadoEm      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, criadoEm])
  @@index([status, ambiente])
  @@map("pedidos_pix")
}
