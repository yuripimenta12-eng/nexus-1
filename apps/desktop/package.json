{
  "name": "nexus-desktop",
  "version": "1.6.1",
  "description": "Nexus Link para Windows e Mac",
  "author": "Nexus Link",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "art.nexuslink.desktop",
    "productName": "Nexus Link",
    "copyright": "Nexus Link",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "games.js",
      "preload.js",
      "picker.html",
      "picker-preload.js",
      "offline.html",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Link",
      "artifactName": "Nexus-Link-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Nexus usa o microfone para você falar nas chamadas.",
        "NSCameraUsageDescription": "O Nexus usa a câmera quando você liga o vídeo nas chamadas."
      }
    },
    "dmg": {
      "artifactName": "Nexus-Link-Mac.${ext}",
      "title": "Nexus Link"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/yuripimenta12-eng/nexus-1/releases/latest/download"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
