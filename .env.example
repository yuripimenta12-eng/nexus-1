# =============================================================
# NEXUS — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# =============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Nexus
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Banco de dados ───────────────────────────────────────────
DATABASE_URL="postgresql://nexus:nexus_secret@localhost:5432/nexus_db?schema=public"

# ── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=troque_por_string_aleatoria_longa_access
JWT_REFRESH_SECRET=troque_por_string_aleatoria_longa_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── LiveKit (SFU) ────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_muito_longa_minimo_32_chars

# ── coturn (TURN/STUN) ───────────────────────────────────────
TURN_URL=turn:localhost:3478
TURN_USERNAME=nexus
TURN_CREDENTIAL=nexus_turn_secret

# ── Storage S3 (MinIO em dev, S3/R2 em prod) ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexus-uploads
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/nexus-uploads

# ── Upload ───────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_FILE_TYPES=application/pdf,text/plain,application/zip

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Admin ────────────────────────────────────────────────────
# E-mail do primeiro admin (criado no seed)
ADMIN_EMAIL=admin@nexus.local
ADMIN_PASSWORD=Admin@123456

# ── SMTP (recuperação de senha) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexus <noreply@nexus.local>"
